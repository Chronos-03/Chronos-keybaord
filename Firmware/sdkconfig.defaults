# GrandLine - ESP32-S3-WROOM-1-N4R8
CONFIG_IDF_TARGET="esp32s3"

# Flash / CPU
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# FreeRTOS: 1 kHz tick (10 ms scan period is exact), tickless idle for light sleep
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y

# Power management (dynamic freq scaling + auto light sleep)
CONFIG_PM_ENABLE=y
CONFIG_PM_DFS_INIT_AUTO=y

# PSRAM firmware support disabled. NOTE: this does not remove the hardware
# conflict - on the N4R8 the PSRAM chip is still wired to GPIO35/36/37, and
# this PCB uses GPIO36 (TFT_PWM) and GPIO37 (TFT_CS). See config/pins.h.
# CONFIG_SPIRAM is not set

# Wi-Fi in ESP-NOW mode only
CONFIG_ESP_WIFI_ESPNOW_MAX_ENCRYPT_NUM=7
